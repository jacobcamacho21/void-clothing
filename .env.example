APP_NAME="VOID Retail System"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=void_pos
DB_USERNAME=root
DB_PASSWORD=

# Legacy source databases (read-only, used by `php artisan void:import-legacy`)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
LEGACY_USERS_DB=users_db
LEGACY_CUSTOMERS_DB=customers_db
LEGACY_INVENTORY_DB=void_inventory

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# --- Store / receipt configuration ---
STORE_NAME="VOID Clothing Co."
STORE_ADDRESS="Tangulan St., Kawit, Cavite 4102"
STORE_TIN="004-215-889-000"
STORE_CURRENCY_SYMBOL="₱"

# --- Commerce rules ---
SHOP_SHIPPING_FEE=50
POS_DISCOUNT_THRESHOLD=3
POS_DISCOUNT_RATE=0.05
TAX_RATE=0.12
TAX_INCLUSIVE=true
LOW_STOCK_THRESHOLD=5
